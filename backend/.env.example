# Required: local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/chat-app

# Required: replace with a long, random secret before using the app
JWT_SECRET=replace-with-a-long-random-secret

# Defaults shown here; the backend and Vite frontend use these local ports
PORT=3000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: configure both values to send signup welcome emails
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Chatify

# Optional: needed for profile pictures and image messages
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Arcjet request protection
ARCJET_KEY=
ARCJET_ENV=development
