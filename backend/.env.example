
# ==========================================
# CHATIFY BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# Database Configuration
# Add your MongoDB local or Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/chat-app

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL
CLIENT_URL=http://localhost:5173

# Email Configuration (Optional)
# Required only if signup emails are enabled
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Chatify

# Cloudinary Configuration (Optional)
# Required for profile pictures and image messages
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Arcjet Security (Optional)
ARCJET_KEY=
ARCJET_ENV=development
